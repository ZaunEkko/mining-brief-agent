# Copy to .env and fill in what you have. Every key is optional:
# without an LLM key the agent runs in deterministic (extractive) mode.

# LLM provider: anthropic | openai | none   (default: auto-detect from the keys below)
MB_LLM_PROVIDER=
ANTHROPIC_API_KEY=
MB_ANTHROPIC_MODEL=claude-opus-5-5
MB_ANTHROPIC_EFFORT=medium
# Server-side refusal fallback (beta); set 0 if your gateway rejects it
MB_ANTHROPIC_SERVER_FALLBACK=1

# Any OpenAI-compatible endpoint (DeepSeek, Qwen/DashScope, GLM, ...)
MB_OPENAI_BASE_URL=
MB_OPENAI_API_KEY=
MB_OPENAI_MODEL=

# 1 = never touch the network, serve only from the bundled fixtures
MB_OFFLINE=0
